target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
.idea/
*.iml
.vscode/
.DS_Store
.flattened-pom.xml

# Local-only notes kept beside the repo rather than in it.
*.local

# Key material — never commit any of this.
# scripts/setup-signing-key.sh pipes the private key straight into GitHub secrets
# so it never lands on disk, but these patterns catch a manual export or an
# accidental `gpg --armor --export-secret-keys > key.asc`.
*.asc
*.gpg
*.pgp
*.key
*.pem
*.p12
*.jks
secring.*
pubring.*
private-key*
*-private.*
.gnupg/
