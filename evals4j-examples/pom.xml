<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.grabdoc</groupId>
    <artifactId>evals4j-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>evals4j-examples</artifactId>
  <name>evals4j :: examples</name>
  <description>Runnable examples. Built by CI so they cannot rot, but never published.</description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.install.skip>true</maven.install.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.grabdoc</groupId>
      <artifactId>evals4j-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.grabdoc</groupId>
      <artifactId>evals4j-springai</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.grabdoc</groupId>
      <artifactId>evals4j-langchain4j</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.grabdoc</groupId>
      <artifactId>evals4j-sandbox</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.grabdoc</groupId>
      <artifactId>evals4j-junit5</artifactId>
    </dependency>

    <!-- Real model clients, so the examples are actually runnable. -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-openai</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j-open-ai</artifactId>
    </dependency>

    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
</project>
